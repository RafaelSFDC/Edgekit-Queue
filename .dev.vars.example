# Edgekit Queue Local Development Configuration
# Copy this file to .dev.vars for local testing:
# cp .dev.vars.example .dev.vars
#
# In production, set API_KEY securely as a Wrangler secret:
# wrangler secret put API_KEY

API_KEY=your-local-dev-api-key
HTTP_REQUEST_TIMEOUT=15
TOTAL_RETRIES_BEFORE_DLQ=3
MAX_CONCURRENT_DELIVERIES=10
