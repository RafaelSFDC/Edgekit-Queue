{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "edgekit-queue",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STASH_STORAGE",
        "class_name": "StashStorage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StashStorage"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "HTTP_REQUEST_TIMEOUT": 15,
    "TOTAL_RETRIES_BEFORE_DLQ": 3,
    "MAX_CONCURRENT_DELIVERIES": 10
  }
}
