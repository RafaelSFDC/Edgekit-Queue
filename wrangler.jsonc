{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-stash",
	"main": "src/index.ts",
	"compatibility_date": "2025-02-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "STASH_STORAGE",
				"class_name": "StashStorage"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"StashStorage"
			]
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"vars": {
		"API_KEY": "stash_secret_key",
		"HTTP_REQUEST_TIMEOUT": 15,
		"TOTAL_RETRIES_BEFORE_DLQ": 3,
		"MAX_CONCURRENT_DELIVERIES": 10
	}
}
